{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "collaboration-bot",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [],
	"workers_dev": false,
	"exports": {
		"CollaborationBotState": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "COLLABORATION_STATE",
				"class_name": "CollaborationBotState"
			}
		]
	}
}
