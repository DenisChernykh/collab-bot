{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "collaboration-bot",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [],
	"workers_dev": false,
	"exports": {
		"CollaborationBotState": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "COLLABORATION_STATE",
				"class_name": "CollaborationBotState"
			}
		]
	},
	"env": {
		"staging": {
			"account_id": "643464cda99dd9fb036367674d42a62c",
			"name": "collaboration-bot-staging",
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"DEPLOYMENT_ENVIRONMENT": "staging",
				"STATE_IMPORT_ENABLED": "false",
				"EXPECTED_BOT_ID": "8777929575",
				"EXPECTED_BOT_USERNAME": "collaboration_development_bot",
				"SHOWCASE_CHANNEL_ID": "-1004314534828",
				"SHOWCASE_CHANNEL_USERNAME": "collaboration_showcase_dev",
				"HELP_CONTACT": "@collaboration_bot_support"
			},
			"secrets": {
				"required": [
					"BOT_TOKEN",
					"TELEGRAM_WEBHOOK_SECRET",
					"OPERATIONS_TOKEN"
				]
			},
			"exports": {
				"CollaborationBotState": {
					"type": "durable-object",
					"storage": "sqlite"
				}
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "COLLABORATION_STATE",
						"class_name": "CollaborationBotState"
					}
				]
			}
		}
	}
}
