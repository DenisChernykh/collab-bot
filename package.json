{
	"name": "collaboration-bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.18.0 <25",
		"pnpm": ">=11.15.1 <12"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"lint": "eslint .",
		"architecture": "dependency-cruise --config .dependency-cruiser.cjs --output-type err src",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:runtime": "vitest run --project runtime",
		"test:e2e:fake": "vitest run --project e2e-fake",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/cli/bot.js",
		"db:migrate": "pnpm build && node dist/cli/db-migrate.js",
		"db:verify": "pnpm build && node dist/cli/db-verify.js",
		"db:state:export": "pnpm build && node dist/cli/state-export.js",
		"cloudflare:types": "wrangler types",
		"cloudflare:types:check": "wrangler types --check",
		"cloudflare:dev": "wrangler dev --local",
		"cloudflare:relay": "pnpm build && node dist/cli/cloudflare-relay.js",
		"cloudflare:typecheck": "tsc -p tsconfig.cloudflare.json --noEmit",
		"cloudflare:migrations:check": "pnpm build && node scripts/verify-cloudflare-migration-manifest.mjs",
		"test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
		"check": "pnpm lint && pnpm architecture && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:runtime && pnpm build"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"date-fns": "4.4.0",
		"date-fns-tz": "3.2.0",
		"grammy": "1.45.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.1",
		"@eslint/js": "9.39.5",
		"@types/node": "24.13.3",
		"dependency-cruiser": "18.1.0",
		"eslint": "9.39.5",
		"typescript": "5.9.3",
		"typescript-eslint": "8.67.0",
		"vitest": "4.1.11",
		"wrangler": "4.127.0"
	}
}
